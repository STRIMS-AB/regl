    {
      "type": "INTEGER",
      "input": 5,
      "expected": true
    },
    {
      "type": "INTEGER",
      "input": 0,
      "expected": true
    },
    {
      "type": "INTEGER",
      "input": -3,
      "expected": true
    },
    {
      "type": "INTEGER",
      "input": 1.0,
      "expected": true,
      "note": "a whole value written with a decimal point"
    },
    {
      "type": "INTEGER",
      "input": 1000.0,
      "expected": true,
      "note": "scientific notation is still whole"
    },
    {
      "type": "INTEGER",
      "input": 2147483648,
      "expected": true,
      "note": "above Integer.MAX_VALUE, so it arrives as Long"
    },
    {
      "type": "INTEGER",
      "input": 9007199254740993,
      "expected": true,
      "note": "above 2^53"
    },
    {
      "type": "INTEGER",
      "input": 5.5,
      "expected": false,
      "note": "a fractional part is the only thing that is not an INTEGER"
    },
    {
      "type": "INTEGER",
      "input": "5",
      "expected": false,
      "note": "no coercion (§8)"
    },
    {
      "type": "INTEGER",
      "input": true,
      "expected": false
    },
    {
      "type": "INTEGER",
      "input": [
        1,
        2
      ],
      "expected": false
    },
    {
      "type": "INTEGER",
      "input": null,
      "expected": false
    },
    {
      "type": "NUMBER",
      "input": 5,
      "expected": true
    },
    {
      "type": "NUMBER",
      "input": 5.5,
      "expected": true,
      "note": "NUMBER accepts what INTEGER rejects"
    },
    {
      "type": "NUMBER",
      "input": "5",
      "expected": false
    },
    {
      "type": "NUMBER",
      "input": null,
      "expected": false
    }
