{
  "cases": [
    {
      "name": "valid single field",
      "fields": [
        {
          "path": "name",
          "type": "STRING",
          "rules": [
            {
              "code": "notNull"
            },
            {
              "code": "minLength",
              "value": 3
            }
          ]
        }
      ],
      "documents": [
        {
          "name": "valid",
          "doc": {
            "name": "abc"
          }
        },
        {
          "name": "missing",
          "doc": {}
        },
        {
          "name": "null",
          "doc": {
            "name": null
          }
        },
        {
          "name": "too short",
          "doc": {
            "name": "ab"
          }
        },
        {
          "name": "wrong type",
          "doc": {
            "name": 5
          }
        }
      ]
    },
    {
      "name": "nested path",
      "fields": [
        {
          "path": "server.port",
