            {
              "code": "greaterThan",
              "value": 1024
            }
          ]
        }
      ],
      "documents": [
        {
          "name": "valid",
          "doc": {
            "server": {
              "port": 8080
            }
          }
        },
        {
          "name": "missing",
          "doc": {}
        },
        {
          "name": "null ancestor",
          "doc": {
            "server": null
          }
        },
        {
          "name": "scalar ancestor",
          "doc": {
            "server": "nope"
          }
        },
        {
          "name": "list ancestor",
          "doc": {
            "server": [
              1
            ]
          }
        },
        {
          "name": "below bound",
          "doc": {
            "server": {
              "port": 80
            }
          }
        },
        {
          "name": "wrong leaf type",
          "doc": {
            "server": {
              "port": "8080"
            }
          }
        },
        {
          "name": "fractional leaf",
          "doc": {
            "server": {
              "port": 80.5
