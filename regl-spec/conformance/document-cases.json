          "rules": [
            {
              "code": "notNull"
            },
            {
              "code": "unique"
            },
            {
              "code": "range",
              "value": {
                "min": 1,
                "max": 5
              }
            }
          ]
        },
        {
          "path": "tags.*",
          "type": "STRING",
          "rules": [
            {
              "code": "notNull"
            },
            {
              "code": "notEmpty"
            }
          ]
        }
      ],
      "documents": [
        {
          "name": "valid",
          "doc": {
            "tags": [
              "x",
              "y"
            ]
          }
        },
        {
          "name": "missing",
          "doc": {}
        },
        {
          "name": "empty list",
          "doc": {
            "tags": []
          }
        },
        {
          "name": "duplicate items",
          "doc": {
            "tags": [
              "x",
              "x"
